# Porta pública da aplicação (padrão HTTP: 80)
PORT=80

# Credenciais do Banco PostgreSQL (coloque senhas fortes na VPS)
POSTGRES_DB=organizeme
POSTGRES_USER=organizeme_user
POSTGRES_PASSWORD=sua_senha_secreta_do_postgres_aqui

# Segredo JWT (Gere uma chave hexadecimal segura com 64 caracteres)
# Dica no Linux: openssl rand -hex 32
JWT_SECRET=coloque_uma_chave_secreta_com_pelo_menos_64_caracteres_aqui
JWT_EXPIRATION=86400000

